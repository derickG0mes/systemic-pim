# SYSTEMIC PIM - Back-end (.NET 10) - Exemplo de Configuração
# Copie este arquivo para .env e preencha com suas configurações locais

# BANCO DE DADOS (SQL Server)
DB_SERVER=localhost
DB_NAME=DB_RESTAURANTE
DB_USER=sa
DB_PASSWORD=sua_senha_forte_aqui

# AUTENTICAÇÃO JWT
# Chave secreta de no mínimo 32 caracteres (256+ bits)
JWT_SECRET_KEY=chave_secreta_jwt_de_exemplo_com_pelo_menos_32_caracteres_12345
JWT_EXPIRATION_MINUTES=480

# SERVIDOR / API
API_PORT=5050
ASPNETCORE_ENVIRONMENT=Development
