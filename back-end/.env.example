# SYSTEMIC PIM - Back-end (.NET 10) - Exemplo de Configuração
# Troque todos os valores TROQUE_*; gere senha/chave com openssl rand -base64 48.
# Copie este arquivo para .env e preencha com suas configurações locais

# BANCO DE DADOS (SQL Server)
DB_SERVER=TROQUE_PELO_HOST_DO_SQL_SERVER
DB_NAME=TROQUE_PELO_NOME_DO_BANCO
DB_USER=TROQUE_PELO_USUARIO_DO_BANCO
DB_PASSWORD=TROQUE_ESTA_SENHA

# AUTENTICAÇÃO JWT
# Gere uma chave exclusiva com: openssl rand -base64 48
JWT_SECRET_KEY=TROQUE_POR_CHAVE_GERADA_COM_OPENSSL
# Validade do token em minutos (inteiro). Padrão 480 se vazio.
JWT_EXPIRATION_MINUTES=480
FORWARDED_HEADERS_KNOWN_PROXIES=TROQUE_PELOS_IPS_DOS_PROXIES_OU_DEIXE_VAZIO

# SERVIDOR / API
# A porta da API é fixa em 5050 (ApiMetadata.Port); não há variável para alterá-la.
# Ambiente de execução: Development habilita Swagger; use Production fora de dev.
ASPNETCORE_ENVIRONMENT=Development
