# SQL Server local no Docker Compose
# Troque todos os valores TROQUE_*; gere senha/chave com openssl rand -base64 48.
DB_SERVER=TROQUE_PELO_HOST_DO_SQL_SERVER
DB_USER=TROQUE_PELO_USUARIO_DO_BANCO
DB_PASSWORD=TROQUE_ESTA_SENHA
# Porta publicada do SQL Server no host (inteiro). Padrão 1433.
SQL_SERVER_PORT=1433

# Gere uma chave exclusiva com: openssl rand -base64 48
JWT_SECRET_KEY=TROQUE_POR_CHAVE_GERADA_COM_OPENSSL
# Validade do token em minutos (inteiro). Padrão 480.
JWT_EXPIRATION_MINUTES=480

# Gere uma chave exclusiva com: openssl rand -base64 48
# Necessária para assinar e validar a integridade dos backups.
BACKUP_HMAC_KEY=TROQUE_POR_CHAVE_GERADA_COM_OPENSSL

# IPs de proxies confiáveis que enviam X-Forwarded-For/Proto, separados por vírgula.
# Deixe vazio quando a API não estiver atrás de um proxy.
FORWARDED_HEADERS_KNOWN_PROXIES=TROQUE_PELOS_IPS_DOS_PROXIES_OU_DEIXE_VAZIO

# Porta publicada do front-end no host (inteiro). Padrão 8080.
FRONTEND_PORT=8080

# Opcional: token de acesso do Expo para a segurança reforçada de push (docs/PUSH_NOTIFICATIONS.md).
# Deixe em branco se não ativou essa opção no painel do Expo.
EXPO_ACCESS_TOKEN=

# Ative apenas para acessar o Compose local por HTTP em dispositivos da rede privada.
# Nunca habilite em produção.
ALLOW_INSECURE_LOCAL_NETWORK=false
