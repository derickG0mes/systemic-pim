# SYSTEMIC PIM - Front-end (Vite + React + TypeScript) - Exemplo de Configuração
# Troque todos os valores TROQUE_*; gere senha/chave com openssl rand -base64 48.
# Copie este arquivo para .env e preencha com suas configurações locais

# SERVIDOR DE DESENVOLVIMENTO (Vite)
VITE_PORT=TROQUE_PELA_PORTA_DO_VITE

# URL DA API (Back-end .NET)
VITE_API_URL=TROQUE_PELA_URL_DA_API

# SIGNALR HUB (Comunicação em tempo real)
VITE_SIGNALR_HUB_URL=TROQUE_PELA_URL_DO_SIGNALR

# AMBIENTE
VITE_APP_ENV=TROQUE_PELO_AMBIENTE_DO_FRONTEND
